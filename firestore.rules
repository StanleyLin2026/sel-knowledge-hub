rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /resources/{resourceId} {
      allow read: if resource.data.status == "published";
      allow write: if false;
    }

    match /metadata/{documentId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
